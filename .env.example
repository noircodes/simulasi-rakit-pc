# Harga Tokopedia via Apify (opsional). Tanpa ini app memakai harga estimasi saja.
APIFY_TOKEN=
# Actor Apify yang dipakai (default di bawah)
APIFY_ACTOR=unnoted~tokopedia-product-search
# Batas pengecekan harga berbayar per hari (semua pengguna)
MARKET_DAILY_LIMIT=10

# Upstash Redis (opsional di lokal; wajib di production supaya cache & rate limit persisten)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
